- primary_button = "inline-flex items-center justify-center w-full sm:w-auto bg-[#2563EB] text-white rounded-md text-[15px] font-bold px-8 h-[52px] hover:opacity-90"
- secondary_button = "inline-flex items-center justify-center w-full sm:w-auto bg-white border border-[#D9D9D4] text-[#1B1B19] rounded-md text-[15px] font-bold px-8 h-[52px] hover:bg-[#F3F3F0]"

section class="bg-[#F6F7F9]"
  div class="max-w-[1200px] mx-auto px-6 lg:px-10 pt-12 pb-16 lg:py-[84px]"
    div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center"
      div class="lg:col-span-5 text-center lg:text-left"
        p class="flex items-center justify-center lg:justify-start gap-3 text-[13px] font-medium text-[#2C4A8A]"
          span class="hidden lg:inline-block w-7 h-px bg-[#2C4A8A]" aria-hidden="true"
          | 日本語と英語の、個人ブログ
        h1 class="font-mincho mt-6 lg:mt-7 text-[34px] lg:text-[48px] leading-[1.5] tracking-[0.08em]"
          | 書きたいことを、
          br
          span class="text-[#2C4A8A]" ふたつの言葉で。
        p class="mt-6 lg:mt-8 text-base lg:text-lg leading-[2] text-[#3A3A36]"
          | 日本語と英語で、自分のペースで書ける。
          br
          | コミュニティもタイムラインもない、
          br
          | あなただけのブログです。

        div class="mt-8 lg:mt-10 flex flex-col sm:flex-row sm:justify-center lg:justify-start gap-3"
          - if user_signed_in?
            = link_to t("welcome.header.dashboard"), dashboard_articles_path, class: primary_button
          - else
            = link_to "ブログをはじめる", new_user_registration_path, class: primary_button, data: { action: "click->auth-modal#showModal", auth_modal_url_param: new_user_registration_path }
            = link_to t("welcome.header.login"), new_user_session_path, class: secondary_button, data: { action: "click->auth-modal#showModal" }

        - unless user_signed_in?
          p class="mt-5 text-[13px] leading-[1.8] text-[#6B6B66]"
            | 無料で使えます。
            br class="sm:hidden"
            | Google・GitHub・メールアドレスで登録できます。

      div class="lg:col-span-7"
        = image_tag "landing/hero.png",
          alt: "同じ日付の日本語の記事と英語の記事を、2枚のカードで並べた様子",
          width: 820, height: 706,
          class: "w-full h-auto rounded-sm"

section class="max-w-[1200px] mx-auto px-6 lg:px-10 py-24 lg:py-[172px] flex flex-col gap-28 lg:gap-[180px]"
  div class="grid grid-cols-1 lg:grid-cols-[7fr_5fr] gap-8 lg:gap-10 items-center"
    div class="bg-[#EEF1F6] rounded-lg p-4 lg:p-5"
      = image_tag "landing/feature_bilingual.png",
        alt: "日本語と英語の記事を、ペアで並べて管理している記事一覧の画面",
        width: 880, height: 530, loading: "lazy",
        class: "w-full h-auto rounded shadow-[0_8px_24px_rgba(27,27,25,0.12)]"
    div
      p class="flex items-baseline gap-4"
        span class="font-mincho text-[22px] text-[#2C4A8A]" 01
        span class="text-[11px] tracking-[0.18em] text-[#55554F]" TWO LANGUAGES, TOGETHER
      h2 class="font-mincho mt-4 lg:mt-5 text-[24px] lg:text-[30px] leading-[1.6] tracking-[0.06em]"
        | 日本語と英語の記事を、
        br
        | ペアで管理。
      p class="mt-5 lg:mt-7 text-[15px] lg:text-base leading-[2] text-[#3A3A36]"
        | 日本語だけ、英語だけ、あるいは両方そろえて。
        br class="hidden lg:inline"
        | 書きたいときに、書きたい言葉で公開できます。

  div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-8 lg:gap-10 items-center"
    div class="bg-[#EEF1F6] rounded-lg p-4 lg:p-5 lg:order-2"
      = image_tag "landing/feature_blog.png",
        alt: "カバー画像と記事タイトルが並ぶ、公開されたブログの画面",
        width: 880, height: 530, loading: "lazy",
        class: "w-full h-auto rounded shadow-[0_8px_24px_rgba(27,27,25,0.12)]"
    div class="lg:order-1"
      p class="flex items-baseline gap-4"
        span class="font-mincho text-[22px] text-[#2C4A8A]" 02
        span class="text-[11px] tracking-[0.18em] text-[#55554F]" YOUR OWN LITTLE PLACE
      h2 class="font-mincho mt-4 lg:mt-5 text-[24px] lg:text-[30px] leading-[1.6] tracking-[0.06em]"
        | 日記を書くように、
        br
        | 誰にも気兼ねなく。
      p class="mt-5 lg:mt-7 text-[15px] lg:text-base leading-[2] text-[#3A3A36]"
        | 読まれた数や反応を気にせずに、
        br class="hidden lg:inline"
        | あなたの言葉を静かに書き綴れる場所です。

  div class="grid grid-cols-1 lg:grid-cols-[7fr_5fr] gap-8 lg:gap-10 items-center"
    div class="bg-[#EEF1F6] rounded-lg p-4 lg:p-5"
      = image_tag "landing/feature_editor.png",
        alt: "Markdown の入力欄とプレビューを左右に並べたエディターの画面",
        width: 880, height: 530, loading: "lazy",
        class: "w-full h-auto rounded shadow-[0_8px_24px_rgba(27,27,25,0.12)]"
    div
      p class="flex items-baseline gap-4"
        span class="font-mincho text-[22px] text-[#2C4A8A]" 03
        span class="text-[11px] tracking-[0.18em] text-[#55554F]" JUST YOU AND YOUR WORDS
      h2 class="font-mincho mt-4 lg:mt-5 text-[24px] lg:text-[30px] leading-[1.6] tracking-[0.06em]"
        | シンプルなエディターで、
        br
        | 書くことに集中。
      p class="mt-5 lg:mt-7 text-[15px] lg:text-base leading-[2] text-[#3A3A36]"
        | Markdown で書きながら、仕上がりをその場で確認できます。
        br class="hidden lg:inline"
        | 見出しやリストも、記号ひとつで整います。
        br class="hidden lg:inline"
        | 翻訳するときは、原文を表示できます。

- unless user_signed_in?
  section class="bg-[#F6F7F9]"
    div class="max-w-[1200px] mx-auto px-6 lg:px-10 py-20 lg:py-[108px] text-center"
      p class="font-mincho italic text-[15px] lg:text-[16px] text-[#2C4A8A]" Every story starts with a word.
      h2 class="font-mincho mt-4 lg:mt-5 text-[24px] lg:text-[30px] leading-[1.6] tracking-[0.06em]"
        | まずは気軽に、
        br class="lg:hidden"
        | はじめてみませんか。
      div class="mt-8 lg:mt-10 flex flex-col sm:flex-row justify-center gap-3"
        = link_to "ブログをはじめる", new_user_registration_path, class: primary_button, data: { action: "click->auth-modal#showModal", auth_modal_url_param: new_user_registration_path }
        = link_to t("welcome.header.login"), new_user_session_path, class: secondary_button, data: { action: "click->auth-modal#showModal" }
