= dashboard_page_title "コメント詳細", class: "mb-6"

div class="bg-white border border-[#E4E4E1] rounded-xl divide-y divide-[#F0F0ED]"
  section class="px-6 py-5"
    h2 class="text-sm font-semibold text-[#1B1B19] mb-3" 記事情報
    dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-2 text-sm"
      dt class="text-[#6B6B66]" タイトル
      dd class="text-[#1B1B19] break-words"
        = link_to @comment.article.title, user_article_path(@comment.article, locale: @comment.article.locale), class: "text-[#2563EB] hover:text-[#1B4FC4] font-medium"
      dt class="text-[#6B6B66]" 言語
      dd class="text-[#1B1B19]"= @comment.article.locale == 'ja' ? '日本語' : '英語'

  section class="px-6 py-5"
    h2 class="text-sm font-semibold text-[#1B1B19] mb-3" コメント情報
    dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-2 text-sm"
      dt class="text-[#6B6B66]" 投稿者
      dd class="text-[#1B1B19] break-words"= @comment.author_name
      dt class="text-[#6B6B66]" 投稿日
      dd class="text-[#1B1B19]"= @comment.created_at.strftime('%Y年%m月%d日 %H:%M')
      - if @comment.website.present?
        dt class="text-[#6B6B66]" ウェブサイト
        dd class="break-all"
          = link_to @comment.website, @comment.website, target: "_blank", rel: "nofollow ugc noopener", class: "text-[#2563EB] hover:text-[#1B4FC4]"

  section class="px-6 py-5"
    h2 class="text-sm font-semibold text-[#1B1B19] mb-3" コメント内容
    div class="text-[15px] leading-relaxed text-[#1B1B19] break-words"
      = simple_format(@comment.content)

div class="flex items-center justify-between mt-6"
  = link_to "一覧に戻る", dashboard_comments_path, class: "inline-flex items-center h-11 px-4 rounded-lg border border-[#E4E4E1] bg-white text-sm text-[#55554F] hover:bg-[#F0F0ED] transition-colors"
  = link_to "削除", dashboard_comment_path(@comment), data: { turbo_method: :delete, turbo_confirm: "削除しますか？" }, class: "inline-flex items-center h-11 px-4 rounded-lg border border-red-200 bg-red-50 text-sm font-medium text-red-700 hover:bg-red-100 transition-colors"
