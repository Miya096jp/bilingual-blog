.flex.items-start.justify-between.mb-6
  div
    h1 class="text-2xl font-bold text-[#1B1B19]" 記事
    p class="text-sm text-[#55554F] mt-1"
      = "#{@status_counts.values.sum} 件(公開 #{@status_counts["published"] || 0}・下書き #{@status_counts["draft"] || 0})"
  = link_to new_dashboard_article_path, class: "inline-flex items-center gap-2 h-11 px-4 rounded-lg bg-[#2563EB] text-white font-medium hover:bg-[#1B4FC4] transition-colors"
    = lucide_icon 'plus', class: "w-4 h-4"
    | 新しい記事を書く

- if @original_articles.any?
  div class="bg-white border border-[#E4E4E1] rounded-xl overflow-hidden"
    table.w-full
      thead
        tr class="border-b border-[#E4E4E1]"
          th class="px-4 py-3 text-left text-xs font-medium text-[#6B6B66]" 日本語
          th class="px-4 py-3 text-left text-xs font-medium text-[#6B6B66]" English
          th class="px-4 py-3 text-left text-xs font-medium text-[#6B6B66]" カテゴリ
          th class="px-4 py-3 text-left text-xs font-medium text-[#6B6B66]" 更新日
          th class="px-4 py-3 text-right text-xs font-medium text-[#6B6B66]"
            span.sr-only 操作
      tbody
        - @original_articles.each do |article|
          = render "dashboard/articles/article_row", article: article

  .mt-6
    = paginate @original_articles
- else
  div class="bg-white border border-[#E4E4E1] rounded-xl p-12 text-center"
    p class="text-[#55554F] mb-4" まだ記事がありません
    = link_to new_dashboard_article_path, class: "inline-flex items-center gap-2 h-11 px-4 rounded-lg bg-[#2563EB] text-white font-medium hover:bg-[#1B4FC4] transition-colors"
      = lucide_icon 'plus', class: "w-4 h-4"
      | 最初の記事を書く
