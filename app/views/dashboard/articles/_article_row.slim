- ja_article = article.locale == "ja" ? article : article.translation
- en_article = article.locale == "en" ? article : article.translation

tr class="border-b border-[#F0F0ED]"
  td class="px-4 py-[12px] align-top"
    = render "dashboard/articles/article_cell", article: article, cell_article: ja_article, locale_label: "日本語"
  td class="px-4 py-[12px] align-top"
    = render "dashboard/articles/article_cell", article: article, cell_article: en_article, locale_label: "英語"
