<!DOCTYPE html>
<html>
  <head>
    <title><%= t("welcome.meta.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= display_meta_tags(default_meta_tags) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body
    class="bg-white text-[#1B1B19] min-h-screen flex flex-col"
    data-controller="auth-modal"
    data-action="keydown->auth-modal#closeOnEscape"
    data-auth-modal-sign-in-url-value="<%= new_user_session_path %>"
  >
    <header>
      <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
        <div class="flex items-center justify-between h-[72px]">
          <%= image_tag "logo.png", alt: "Dual Pascal", width: 167, height: 24, class: "h-[22px] w-auto sm:h-6" %>

          <div class="flex items-center gap-4 sm:gap-6">
            <% if user_signed_in? %>
              <%= link_to t("welcome.header.dashboard"),
              dashboard_articles_path,
              class: "bg-[#1B1B19] text-white rounded-md text-sm font-bold px-5 py-2.5 hover:opacity-85" %>
            <% else %>
              <%= link_to t("welcome.header.login"),
              new_user_session_path,
              data: { action: "click->auth-modal#showModal" },
              class: "text-sm text-[#3A3A36] hover:text-[#1B1B19]" %>
              <%= link_to t("welcome.header.get_started"),
              new_user_registration_path,
              data: { action: "click->auth-modal#showModal", auth_modal_url_param: new_user_registration_path },
              class: "bg-[#1B1B19] text-white rounded-md text-sm font-bold px-5 py-2.5 hover:opacity-85" %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <% flash.each do |type, message| %>
      <div class="flash-message text-red-700 p-4 mb-4 max-w-6xl mx-auto text-center">
        <p><%= message %></p>
      </div>
    <% end %>

    <%= render "shared/auth_modal" unless user_signed_in? %>

    <main class="flex-grow">
      <%= yield %>
    </main>

    <footer>
      <div class="max-w-[1200px] mx-auto px-6 lg:px-10 py-10 lg:py-12">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 text-sm text-[#55554F]">
          <div class="flex flex-col lg:flex-row lg:items-center gap-3 lg:gap-5">
            <%= image_tag "logo.png", alt: "Dual Pascal", width: 125, height: 18, class: "h-[22px] lg:h-[18px] w-auto self-start lg:self-auto" %>
            <p><%= t("welcome.footer.tagline") %></p>
          </div>
          <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-7">
            <nav class="flex flex-wrap gap-x-6 gap-y-2">
              <%= link_to t("footer.terms"),
              terms_of_service_path(locale: params[:locale] || I18n.locale),
              class: "hover:text-[#1B1B19]" %>
              <%= link_to t("footer.privacy"),
              privacy_policy_path(locale: params[:locale] || I18n.locale),
              class: "hover:text-[#1B1B19]" %>
              <%= link_to t("welcome.footer.contact"),
              new_contact_path(locale: params[:locale] || I18n.locale),
              class: "hover:text-[#1B1B19]" %>
            </nav>
            <span>© <%= Time.current.year %> Dual Pascal</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
