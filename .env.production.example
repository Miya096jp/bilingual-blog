# Production environment variables for compose.prod.yaml
# Copy to .env on the VPS and fill in the values. Never commit the real .env.
# Other secrets (GitHub/Google OAuth, Resend, Umami fallback) are in
# config/credentials.yml.enc, decrypted with RAILS_MASTER_KEY.

# Rails
RAILS_ENV=production
RAILS_MASTER_KEY=
RAILS_LOG_TO_STDOUT=true

# PostgreSQL (db container + Rails)
# POSTGRES_DB must match the database name in config/database.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=bilingual_blog_production
POSTGRES_HOST=db

# Cloudflare R2 (Active Storage)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
# Not referenced in the code (as of 2026-09) — possibly unused
CLOUDFLARE_R2_PUBLIC_URL=

# Umami analytics API
UMAMI_API_CLIENT_HOST=
UMAMI_API_CLIENT_USERNAME=
UMAMI_API_CLIENT_PASSWORD=
